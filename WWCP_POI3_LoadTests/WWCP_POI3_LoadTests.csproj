<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WWCP_POI3_LoadTests</AssemblyName>
    <RootNamespace>cloud.charging.open.protocols.WWCP.POI.loadtests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The garbage collector of the hub: DOTNET_gcServer=0 measures the workstation GC instead. -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WWCP_POI3\WWCP_POI3.csproj" />
  </ItemGroup>

</Project>
